# Credenciales SMTP del correo propio de Midas (redirigido vía Cloudflare)
# Copiá este archivo a .env y completá los valores reales. .env NUNCA se commitea.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=midas@raccoondev.dev
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres

# A quién le llegan los emails de escalación (el CEO)
CEO_EMAIL=sergio.70s.sa@gmail.com

# Moneda base del sistema. Todos los montos se registran en esta moneda.
BASE_CURRENCY=USD

# Umbral (en BASE_CURRENCY) a partir del cual flag_large_expense() congela
# el gasto y lo escala al CEO en vez de registrarlo directo.
EXPENSE_THRESHOLD=1000

# Credenciales de Neo4j AuraDB — MISMA instancia que usa Dante (gg-raccoon/.env),
# usadas por graphrag_sync() para el nodo de memoria de Midas.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu-password-de-aura

# Clave de la API de Anthropic — MISMA que usa Dante (gg-raccoon/.env) — usada
# por meeting_presence() para detectar implicaciones financieras en reuniones.
ANTHROPIC_API_KEY=sk-ant-...
