# Credenciales SMTP del correo propio de Volt (redirigido vía Cloudflare)
# Copiá este archivo a .env y completá los valores reales. .env NUNCA se commitea.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=volt@raccoondev.dev
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres

# A quién le llegan los emails de escalación (el CEO)
CEO_EMAIL=sergio.70s.sa@gmail.com

# Clave de la API de Anthropic — MISMA que usan Dante/Midas — usada por
# code_review() y meeting_presence() (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-...

# Credenciales de Neo4j AuraDB — MISMA instancia que Dante/Midas, usadas
# por graphrag_sync() para el nodo de memoria de Volt.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu-password-de-aura
