# Credenciales SMTP del correo propio de Dante (gg-raccoon@tudominio / redirigido por Cloudflare)
# Copiá este archivo a .env y completá los valores reales. .env NUNCA se commitea (ver .gitignore raíz).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dante@tudominio.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres

# A quién le llegan los emails de escalación (el CEO)
CEO_EMAIL=sergio.70s.sa@gmail.com

# Clave de la API de Anthropic, usada por meeting_notes() (Modo 1) para
# procesar transcripciones con Claude. Conseguila en console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Credenciales de Neo4j AuraDB (free tier), usadas por graphrag_sync() para
# el nodo de memoria de Dante (decisiones y tareas, no logs completos).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu-password-de-aura
